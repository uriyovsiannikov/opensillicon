override NETSURF_FB_FRONTEND := x
override NETSURF_FB_FONTLIB := freetype
override NETSURF_USE_DUKTAPE := NO
override NETSURF_USE_OPENSSL := NO
override NETSURF_USE_NSLOG := NO
override NETSURF_USE_ROSPRITE := NO
override NETSURF_USE_WEBP := NO
override NETSURF_USE_JPEGXL := NO
override NETSURF_USE_NSSVG := YES
override NETSURF_USE_NSPSL := YES
override NETSURF_USE_UTF8PROC := YES
override NETSURF_USE_LIBICONV_PLUG := NO
override NETSURF_FS_BACKING_STORE := NO
override NETSURF_LOG_LEVEL := INFO
override NETSURF_FRAMEBUFFER_RESOURCES := /usr/share/netsurf
override NETSURF_FB_RESPATH := /etc/netsurf:/usr/share/netsurf
override NETSURF_FB_FONTPATH := /usr/share/fonts/truetype/liberation
override NETSURF_FB_FONT_SANS_SERIF := LiberationSans-Regular.ttf
override NETSURF_FB_FONT_SANS_SERIF_BOLD := LiberationSans-Bold.ttf
override NETSURF_FB_FONT_SANS_SERIF_ITALIC := LiberationSans-Italic.ttf
override NETSURF_FB_FONT_SANS_SERIF_ITALIC_BOLD := LiberationSans-BoldItalic.ttf
override NETSURF_FB_FONT_SERIF := LiberationSerif-Regular.ttf
override NETSURF_FB_FONT_SERIF_BOLD := LiberationSerif-Bold.ttf
override NETSURF_FB_FONT_MONOSPACE := LiberationMono-Regular.ttf
override NETSURF_FB_FONT_MONOSPACE_BOLD := LiberationMono-Bold.ttf
override NETSURF_FB_FONT_CURSIVE := LiberationSans-Italic.ttf
override NETSURF_FB_FONT_FANTASY := LiberationSerif-Regular.ttf
override NETSURF_HOMEPAGE := https://frogfind.com/
CFLAGS += -ffunction-sections -fdata-sections
LDFLAGS += -Wl,--gc-sections

override NETSURF_UA_FORMAT_STRING := Mozilla/5.0\ \(%s\)\ NetSurf/%d.%d
