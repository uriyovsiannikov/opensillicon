#!/bin/sh
set -eu

if [ ! -r /usr/share/minecraft/client.jar ]; then
	printf '%s\n' 'minecraft: client.jar is missing from /usr/share/minecraft' >&2
	exit 1
fi

exec /usr/bin/java -Xmx512m "-Duser.home=${HOME:-/tmp}" \
	-cp '/usr/share/minecraft/client.jar:/usr/share/minecraft/lwjgl-2.9.0.jar:/usr/share/minecraft/lwjgl_util-2.9.0.jar:/usr/share/minecraft/jinput-2.0.5.jar:/usr/share/minecraft/jutils-1.0.0.jar' \
	net.minecraft.client.Minecraft "$@"
